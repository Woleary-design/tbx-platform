# Supabase browser/server configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private admin access. Multiple addresses may be comma-separated.
TBX_ADMIN_EMAILS=owner@example.com

# Transaction launch gates. Leave false until the corresponding integration
# has passed a real sandbox purchase, refund and courier-booking test.
TBX_PAYMENTS_LIVE=false
TBX_COURIER_QUOTES_LIVE=false
TBX_REQUIRE_VERIFIED_SELLERS=false

# The Courier Guy / PUDO via ShipLogic. Start with a sandbox API key.
# Register at https://sandbox.shiplogic.com/register
SHIPLOGIC_ENVIRONMENT=sandbox
SHIPLOGIC_API_URL=https://api.shiplogic.com
SHIPLOGIC_API_TOKEN=your-server-only-api-token
SHIPLOGIC_PROVIDER_ID=your-courier-provider-id
SHIPLOGIC_ACCOUNT_ID=your-shiplogic-account-id

# Optional Atlas current-market provider. Server-only.
# When configured, Atlas uses structured Google Shopping results for exact LEGO set pricing.
# Without it, Atlas falls back to public shopping/official LEGO retail evidence where available.
# SERPAPI_KEY=your-serpapi-key

# Optional Atlas import controls
# REBRICKABLE_SETS_URL=https://cdn.rebrickable.com/media/downloads/sets.csv.gz
# REBRICKABLE_THEMES_URL=https://cdn.rebrickable.com/media/downloads/themes.csv.gz
# ATLAS_IMPORT_DRY_RUN=true
# ATLAS_IMPORT_LIMIT=100
